{
  "name": "@ggboy123/dsh-zotero-reader",
  "version": "0.3.0",
  "description": "DeepSeek Harness 的 Zotero 论文阅读器：PDF/文本双视图、双击定位跳转、划词与截图解释、独立高亮和逐页翻译。",
  "license": "MIT",
  "type": "module",
  "author": "GGboya",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib/client.js",
    "vendor",
    "scripts/pdf-to-md.py",
    "scripts/run-pdf2zh.py",
    "scripts/mineru-to-content.py",
    "SETUP-AGENT.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run clean && npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "node test/selection.test.mjs && node test/notes.test.mjs && node test/llm.test.mjs && node test/mineru.test.mjs && node test/richtext.test.mjs && node test/composer.test.mjs && node test/page-translation.test.mjs && node test/selection-anchor.test.mjs && node test/paper-summary.test.mjs",
    "test:markdown": "node test/markdown.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pdf-reader",
    "paper",
    "zotero"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "html2canvas": "^1.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hydralune/dsh-zotero-reader.git"
  },
  "homepage": "https://github.com/Hydralune/dsh-zotero-reader#readme",
  "bugs": {
    "url": "https://github.com/Hydralune/dsh-zotero-reader/issues"
  },
  "contributors": [
    {
      "name": "Hydralune",
      "url": "https://github.com/Hydralune"
    }
  ]
}
